# Integration Test Environment Variables
# This file contains environment variables needed for running integration tests
# Fill in your actual values below

# Claude API Key (Required for integration tests)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=

# Test Convex Deployment URL (Required for integration tests)
# Use your development/test Convex deployment
# Get from: Convex Dashboard > Settings > Deployment URL
TEST_CONVEX_URL=

# Optional: Test-specific room and event IDs
# These will be created by the test suite if not provided
# TEST_ROOM_ID=
# TEST_EVENT_ID=

# Optional: Firecrawl API (for vendor agent tests)
# FIRECRAWL_API_KEY=
